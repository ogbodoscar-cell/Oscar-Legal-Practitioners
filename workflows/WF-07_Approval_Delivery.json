        {
            "parameters": {
                "jsCode": "// Build unified approval payload and restore PII for lawyer review\nconst inputs = $input.all();\nconst firstItem = inputs[0]?.json || {};\nconst mc = firstItem.matter_context || {};\nconst tokenMap = mc.token_map || {};\n\n// Collect all agent outputs\nconst agentOutputs = inputs\n  .map(i => i.json?.agent_output)\n  .filter(Boolean);\n\n// Build readable preview for lawyer\nlet previewParts = agentOutputs.map(ao => {\n  if (ao.agent === 'research') {\n    return `📚 *Research Brief*\\n${ao.content?.research_title || 'Research Output'}\\nFindings: ${(ao.content?.findings || []).length} items\\nSources: ${(ao.content?.sources_used || []).join(', ')}`;\n  } else if (ao.agent === 'drafting') {\n    return `📝 *Draft Document*\\n${ao.document_title || 'Legal Draft'}\\nVersion: ${ao.version}\\nDownload/Edit Link: ${ao.drive_url || 'Uploading to Drive...'}\\n\\n*Instructions:* ${(ao.instructions_to_lawyer || []).join(', ')}`;\n  } else if (ao.agent === 'crm') {\n    return `📧 *Communication Draft*\\n${ao.document_title || 'Client Communication'}\\nType: ${ao.output_type}`;\n  }\n  return `✅ Output from ${ao.agent} agent`;\n});\n\nlet combinedPreview = previewParts.join('\\n\\n');\n\n// Restore PII in the preview only (AI never saw these names)\nfor (const [token, realValue] of Object.entries(tokenMap)) {\n  combinedPreview = combinedPreview.split(token).join(realValue);\n}\n\nreturn [{\n  json: {\n    ...firstItem,\n    agent_outputs: agentOutputs,\n    channel: mc.channel || 'email',\n    sender: mc.sender,\n    matter_id: mc.matter_id,\n    preview_text: combinedPreview,\n    output_type: firstItem.output_type || 'multi_agent',\n    message: firstItem.message || null,\n    is_clarification: firstItem.output_type === 'clarification'\n  }\n}];"
            },
            "id": "build-approval-payload",
            "name": "Build Approval Payload",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                420,
                400
            ]
        },
