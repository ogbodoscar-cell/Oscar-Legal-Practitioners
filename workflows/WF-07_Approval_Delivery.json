        {
            "parameters": {
                "jsCode": "// Extract and finalize AI decision with robust fallback\nconst inputs = $input.all();\nconst first = inputs[0].json;\nconst raw = first.output || first.message?.content || '{}';\n\nlet result = {};\ntry {\n  const jsonStr = raw.replace(/```json|```/g, '').trim();\n  result = JSON.parse(jsonStr);\n} catch(e) {\n  // Fallback to keyword scan if JSON fails\n  const text = raw.toUpperCase();\n  result = {\n    approval_decision: text.includes('APPROVE') ? 'approved' : text.includes('REJECT') ? 'rejected' : 'revise',\n    revision_feedback: raw,\n    is_direct_edit: text.includes('EDITED') || text.includes('FIXED'),\n    tone_analysis: 'Fallback detection'\n  };\n}\n\nreturn [{\n  json: {\n    ...first,\n    ...result,\n    approved_at: new Date().toISOString()\n  }\n}];"
            },
            "id": "finalize-decision",
            "name": "Finalize AI Decision",
            "type": "n8n-nodes-base.code",
