      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst match = item.matches?.[0];\nconst isExisting = match && match.score >= 0.88;\nconst norm = $(\"Normalize Payload\").first().json;\n\n// We pull the vector from the OpenAI Embeddings node that preceded the search\nconst embeddingNode = $(\"OpenAI Embeddings\").first().json;\nconst vector = embeddingNode.data?.[0]?.embedding || null;\n\nreturn [{\n  json: {\n    ...norm,\n    embedding: vector,\n    semantic_results: item.matches || [],\n    is_new_matter: !isExisting,\n    matter_id: isExisting ? match.metadata.matter_id : (norm.matter_id || ''),\n    existing_matter_name: isExisting ? match.metadata.matter_name : null,\n    matched_score: match?.score || 0\n  }\n}];"
      },
