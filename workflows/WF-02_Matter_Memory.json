      "parameters": {
        "jsCode": "// Prepare payload for embedding\nconst item = $input.first().json;\nlet textToEmbed = '';\nconst action = item.action || (item.file_id ? 'ingest' : 'intake');\n\nif (action === 'intake') {\n  textToEmbed = `${item.summary} | Type: ${item.matter_type} | Parties: ${(item.real_parties || []).join(', ')}`;\n} else if (action === 'ingest') {\n  textToEmbed = `APPROVED DOCUMENT: ${item.document_title || item.title}\\nMatter: ${item.matter_id || 'unassigned'}\\nContent: ${item.text || item.clean_text}`;\n} else {\n  textToEmbed = item.query || item.clean_text || 'search';\n}\n\nreturn [{ json: { ...item, action, text_to_embed: textToEmbed } }];"
      },
