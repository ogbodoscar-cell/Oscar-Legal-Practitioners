      "parameters": {
        "jsCode": "// Generate Matter ID: LP/YYYY/NNN\nconst intake = $(\"Check Similarity\").first().json;\nconst items = $input.all();\n\nconst year = new Date().getFullYear();\nlet seq = 1;\nif (items.length > 0 && items[0].json && items[0].json.matter_id) {\n  const lastId = items[0].json.matter_id;\n  seq = parseInt(lastId.split('/')[2] || '0') + 1;\n}\nconst matterId = `LP/${year}/${String(seq).padStart(3, '0')}`;\nconst matterName = `${intake.matter_type || 'Legal Matter'} — ${intake.timestamp?.slice(0,10) || new Date().toISOString().slice(0,10)}`;\n\nreturn [{\n  json: {\n    ...intake,\n    matter_id: matterId,\n    matter_name: matterName\n  }\n}];"
      },
